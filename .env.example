# PRIVASEC Environment Configuration

# Core Security Keys
SECRET_KEY=privasec-super-secret-development-key-32chars-min-length-99!
ENCRYPTION_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_PEPPER_KEY=privasec-pseudonym-pepper-key-2026-secure

# Database & Cache
# Local development default uses SQLite: sqlite+aiosqlite:///./privasec.db
# Docker Compose uses PostgreSQL:
DATABASE_URL=sqlite+aiosqlite:///./privasec.db
REDIS_URL=redis://localhost:6379/0

# App Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Risk Weights
RISK_WEIGHT_AUTH=0.25
RISK_WEIGHT_BEHAVIOR=0.20
RISK_WEIGHT_ML_ANOMALY=0.20
RISK_WEIGHT_API_SECURITY=0.20
RISK_WEIGHT_DATA_SENSITIVITY=0.15
